# AgriNexa Backend Environment Configuration
PROJECT_NAME="AgriNexa Agricultural Intelligence"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Supabase Database & Auth Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Machine Learning & Optimization Settings
DEFAULT_FORECAST_DAYS=14
UNCERTAINTY_SIGMA_MULTIPLIER=1.28
DEFAULT_MAX_SEARCH_RADIUS_KM=150.0

# Multilingual AI Voice Chatbot Configuration (Task 8)
AI_CHATBOT_PROVIDER="deterministic_apmc"  # Options: deterministic_apmc, gemini, openai
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
DEFAULT_CHATBOT_LANGUAGE="auto"  # Options: auto, kn, en
